APP_NAME="Money Maze"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

LOG_CHANNEL=stack
LOG_LEVEL=error

# Recommended for Hostinger VPS: MySQL (create DB in hPanel or via mysql CLI)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=money_maze
DB_USERNAME=money_maze_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Alternative: SQLite (simpler, fine for small traffic)
# DB_CONNECTION=sqlite
# DB_DATABASE=/var/www/money-maze/database/database.sqlite

CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=hello@your-domain.com
MAIL_PASSWORD=YOUR_EMAIL_PASSWORD
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="hello@your-domain.com"
MAIL_FROM_NAME="Money Maze"

VITE_APP_NAME="${APP_NAME}"

# Change before going live!
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
