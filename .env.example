APP_NAME="Money Maze"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Local development:
APP_URL=http://localhost:8000
# Going live with cloudflared? Run `cloudflared tunnel --url http://localhost:8000`
# and set APP_URL in your .env to the printed tunnel URL, e.g.:
# APP_URL=https://money-maze.trycloudflare.com
#
# Vite CSS/JS and asset() URLs follow the request host automatically, so the
# same build works on localhost and the tunnel. Only set ASSET_URL to pin
# assets to a fixed base (CDN / permanent domain):
# ASSET_URL=https://money-maze.trycloudflare.com

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@moneymaze.in"
MAIL_FROM_NAME="Money Maze"

VITE_APP_NAME="${APP_NAME}"
